# Copy to .env.local (development) or .env.production and set your own values. Never commit real keys.
OPENAI_API_KEY=your-openai-api-key
NEXT_PUBLIC_OPENAI_API_KEY=your-openai-api-key
# OAuth access token for the job-board GraphQL API
NEXT_PUBLIC_JOB_API_TOKEN=your-job-api-access-token
# Base URL of the backend (freelance-hub-api)
NEXT_PUBLIC_API_PATH=http://localhost:3001
NEXT_PUBLIC_API_PATH_SERVER_2=http://localhost:3001
NEXT_PUBLIC_PERSONAL_SITES_API_DOMAIN=http://localhost:3337
NEXT_PUBLIC_SITE_URL=http://localhost:5000
